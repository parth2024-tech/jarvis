# ==============================================================================
# J.A.R.V.I.S. (Iron Man Edition) — Project .gitignore
# ==============================================================================

# Python Bytecode & Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
ENV/
env/

# Test, Lint & Build Caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# J.A.R.V.I.S. Runtime Memory & Ephemeral Stores
memory/*.db
memory/*.db-shm
memory/*.db-wal
memory/*.log
memory/*.png
memory/tts_cache/
logs/
*.log

# Sensitive Credentials & Local Overrides
.env
.env.local
*.auth_token

# System & Editor Specifics
.DS_Store
.idea/
.vscode/
*.swp
*.swo
